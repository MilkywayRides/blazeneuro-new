<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Main Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Fixed Header -->
            <LinearLayout
                android:id="@+id/fixedHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:background="@drawable/header_fade_gradient">

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_menu"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/menu_button_bg"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tvCourseTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Course Title"
                    android:textColor="@color/foreground"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Sticky Video Container -->
            <FrameLayout
                android:id="@+id/stickyVideoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="#000000" />

            <!-- Scrollable Content -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/nestedScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:clipToPadding="false"
                    android:paddingBottom="104dp">

                    <FrameLayout
                        android:id="@+id/contentContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:clipToPadding="false" />

                </androidx.core.widget.NestedScrollView>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </LinearLayout>

        <!-- Floating Bottom Progress Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="40dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- The Unified Blur Background for both Bump and Card -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/progressCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:elevation="8dp"
                android:background="@drawable/feedback_glass_bg"
                app:blurOverlayColor="@color/glass_bg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:clipChildren="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false">

                    <!-- Content (List) -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvExpandedPages"
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:visibility="gone"
                        android:clipToPadding="false" />

                    <!-- Header (Bar) -->
                    <LinearLayout
                        android:id="@+id/progressHeader"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/btnPrevious"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_previous"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/feedback_glass_btn"
                            android:padding="8dp" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp">

                            <ProgressBar
                                android:id="@+id/progressBar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_gravity="center"
                                android:max="100"
                                android:progressTint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/progressText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/btnNext"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_next"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/feedback_glass_btn"
                            android:padding="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <!-- The Melted Bump Handle (Sibling for no cropping) -->
            <FrameLayout
                android:id="@+id/expandHandle"
                android:layout_width="60dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_melted_bump"
                android:elevation="9dp"
                app:layout_constraintBottom_toTopOf="@id/progressCard"
                app:layout_constraintStart_toStartOf="@id/progressCard"
                app:layout_constraintEnd_toEndOf="@id/progressCard"
                android:layout_marginBottom="-1dp"
                android:clickable="true"
                android:focusable="true">
                
                <ImageView
                    android:id="@+id/icExpand"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="2dp"
                    android:src="@drawable/ic_expand_less"
                    app:tint="@color/foreground"
                    android:alpha="0.6"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Confetti Celebration -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieConfetti"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:elevation="100dp"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            android:scaleType="centerCrop" />

        <!-- First Time User Guide -->
        <FrameLayout
            android:id="@+id/guideOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC09090B"
            android:elevation="20dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="60dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:background="@drawable/card_background">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_help"
                    app:tint="@color/primary"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Navigation Guide"
                    android:textColor="@color/foreground"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You can change pages using the Next/Previous buttons at the bottom, or select a specific page from the sidebar menu."
                    android:textColor="@color/muted_foreground"
                    android:textAlignment="center"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="28dp"/>

                <Button
                    android:id="@+id/btnGotIt"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Got It!"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_foreground"
                    android:background="@drawable/button_primary"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </FrameLayout>

    </FrameLayout>

    <!-- Sidebar -->
    <LinearLayout
        android:id="@+id/sidebarMenu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/card">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Course Pages"
            android:textColor="@color/foreground"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
